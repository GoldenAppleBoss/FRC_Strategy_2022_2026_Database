{
  "schema_version": "1.0",
  "template": "team1833/1833_Task_List_Template.xlsx",
  "protocol": "docs/TASK_LIST_PROTOCOL.md",
  "worksheet": "Task List",
  "worksheet_count": 1,
  "table": "RobotTasks",
  "header_row": 12,
  "first_task_row": 13,
  "last_starter_task_row": 92,
